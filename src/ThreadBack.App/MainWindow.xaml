<Window x:Class="ThreadBack.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/ThreadBack.ico" Title="ThreadBack — Pick up your thought" Width="1320" Height="900" MinWidth="1100" MinHeight="720" Background="#F7F5F9" Foreground="#292538" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#292536" Padding="22,30,18,22">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/ThreadBack.png" Width="32" Height="32" Margin="0,0,8,0"/><TextBlock Text="ThreadBack" Foreground="#FAF7FF" FontSize="25" FontWeight="Bold"/></StackPanel><TextBlock Text="A handoff to your future self." Foreground="#BEB6D1" FontSize="12" Margin="0,9,0,30"/></StackPanel>
        <Button Grid.Row="1" Content="＋  New task" Background="#BBA3EC" Foreground="#292536" Click="NewTask_Click" Margin="0,0,0,22"/>
        <TextBlock Grid.Row="2" Text="YOUR TASKS" Foreground="#ABA1C0" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBox Grid.Row="3" x:Name="SearchBox" ToolTip="Find a saved task by title" TextChanged="Search_Changed" Margin="0,0,0,14" FontSize="12"/>
        <ListBox Grid.Row="4" x:Name="TaskList" Background="Transparent" BorderThickness="0" SelectionChanged="TaskList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,14"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#EEE9F6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#453B59"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#3B334C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" Foreground="#EEE9F6" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MMM d · h:mm tt}}" Foreground="#ACA2BF" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="5"><Button Content="Show overlay" Click="Overlay_Click" Margin="0,8,0,0"/><Button x:Name="SettingsButton" Content="⚙  Model settings" Click="Settings_Click" Margin="0,8,0,0"/><Button Content="Try an example" Click="Demo_Click" Background="#40364F" Foreground="#E4DAF4" Margin="0,14,0,20"/><TextBlock Text="●  Stored on this PC" Foreground="#C6D7C5" FontSize="12"/><TextBlock Text="Screen capture only when you request it or turn Eye on." Foreground="#ABA1C0" FontSize="11" Margin="0,7,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,28,30,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LEAVE A THREAD. FIND YOUR WAY BACK." FontSize="10" FontWeight="Bold" Foreground="#80669D"/><TextBlock x:Name="PageHeading" Text="Pause with a clear next step." FontSize="28" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="Keep the reasoning, the loose ends, and the evidence together." Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel><Border Grid.Column="1" Background="#E9F0E9" CornerRadius="14" VerticalAlignment="Top" Padding="12,7" Margin="10,6,0,0"><TextBlock Text="LOCAL FIRST" Foreground="#47654C" FontSize="10" FontWeight="Bold"/></Border></Grid>
      <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="EditTab" Content="01  Capture a handoff" Click="EditTab_Click"/><Button x:Name="ResumeTab" Content="02  Resume your task" Click="ResumeTab_Click"/></StackPanel><Button Grid.Column="1" x:Name="UnloadAiButton" Content="Unload AI from RAM" Click="UnloadAi_Click" IsEnabled="False"/><Button Grid.Column="2" Content="Save capsule" Click="Save_Click" Background="#7151BF" Foreground="White" Margin="0"/></Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <StackPanel x:Name="EditPanel">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WHAT ARE YOU WORKING ON?" Style="{StaticResource Label}"/><TextBox x:Name="TitleBox" MaxLength="120" TextChanged="Draft_Changed" AutomationProperties.Name="Task title"/><TextBlock Text="THE GOAL" Style="{StaticResource Label}" Margin="0,16,0,8"/><TextBox x:Name="GoalBox" MaxLength="600" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="68" TextChanged="Draft_Changed" AutomationProperties.Name="Task goal"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Evidence, in your words" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="What changed? What did you rule out? What should happen next?" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,13"/></StackPanel><TextBlock Grid.Column="1" x:Name="EvidenceCount" Text="0 sources" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/></Grid><TextBox x:Name="NoteBox" MinHeight="95" MaxHeight="180" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Draft_Changed" AutomationProperties.Name="New evidence note"/><WrapPanel Margin="0,12,0,0"><Button Content="＋ Add note" Click="AddNote_Click"/><Button Content="＋ Screenshot" Click="AddScreenshot_Click"/><Button x:Name="VoiceButton" Content="＋ Voice file" Click="AddVoice_Click"/><Button x:Name="RecordButton" Content="● Record" Click="Record_Click"/></WrapPanel><TextBlock Text="Three notes · three screenshots · one voice memo (60 seconds). Preview before saving." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/><StackPanel x:Name="EvidenceEditor" Margin="0,16,0,0"/></StackPanel></Border>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="The AI drafts a handoff from your sources. You review it." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Grid.Column="1" x:Name="DescribeAllButton" Content="Describe all screenshots" Click="DescribeAll_Click" ToolTip="Describe screenshots without descriptions using one local model load. Review each result before creating a capsule."/><Button Grid.Column="2" x:Name="GenerateButton" Content="Create my resume capsule  →" Background="#7151BF" Foreground="White" Click="Generate_Click"/><Button Grid.Column="3" x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click"/></Grid>
          </StackPanel>
          <StackPanel x:Name="ResumePanel" Visibility="Collapsed">
            <Border Background="#EEE7F8" CornerRadius="12" Padding="22" Margin="0,0,0,18"><StackPanel><TextBlock Text="YOUR NORTH STAR" Foreground="#76579C" FontWeight="Bold" FontSize="10"/><TextBlock x:Name="ResumeGoal" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="ResumeFocus" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock x:Name="RuntimeLabel" Foreground="#78678F" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
            <DockPanel Margin="0,0,0,14"><Button Content="↻ Regenerate from saved sources" Click="Generate_Click" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="Check the evidence. Edit any statement before relying on it." Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WHAT YOU WERE DOING" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="A chronological draft from your notes and screen observations. Check each source." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,12"/><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ActivityTimeline"/></ScrollViewer></StackPanel></Border>
            <UniformGrid x:Name="BriefCards" Columns="2"/>
            <WrapPanel Margin="0,4,0,16"><Button Content="Review all sources" Click="ReviewSources_Click"/><Button Content="Export handoff…" Click="Export_Click"/><Button Content="Delete capsule…" Click="Delete_Click" Background="#F2E5E6" Foreground="#873C49"/></WrapPanel>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="3" Background="#EEEBF2" CornerRadius="8" Padding="12,9" Margin="0,8,0,0"><DockPanel><Button x:Name="FooterCancel" Content="Cancel" Click="Cancel_Click" DockPanel.Dock="Right" Visibility="Collapsed" Margin="12,0,0,0"/><StackPanel><ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Foreground="#9474C6" Margin="0,0,0,7" Visibility="Collapsed"/><TextBlock x:Name="StatusLabel" Text="Ready. Add a task, or try the example in the sidebar." FontSize="12" Foreground="#62596F"/></StackPanel></DockPanel></Border>
    </Grid>
  </Grid>
</Window>

